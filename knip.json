{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/entrypoints/cli.tsx",
    "src/entrypoints/mcp.ts",
    "src/entrypoints/init.ts",
    "src/entrypoints/sdk/index.ts",
    "src/main.tsx",
